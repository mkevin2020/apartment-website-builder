# ============================================================================
# Cielo Vista — environment template
#
# Copy to .env.local and fill in real values. .env.local is gitignored.
# NEVER put a real secret in this file — it IS committed.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore public. Everything else must stay server-side only.
# ============================================================================

# ── Security secrets (REQUIRED in production) ───────────────────────────────
# The app refuses to boot in production if these are missing or too short.
# Generate each with:  openssl rand -base64 48

# Signs the session cookie that authenticates every request. Anyone who learns
# this value can forge an admin session, so treat it like a root password.
SESSION_SECRET=generate_with_openssl_rand_base64_48

# Signs receipt QR verification tokens and the rotating office attendance code.
JWT_SECRET=generate_with_openssl_rand_base64_48

# Encrypts national ID numbers at the application layer (AES-256-GCM).
# Must be EXACTLY 32 bytes, base64:  openssl rand -base64 32
# Optional — if unset, ID numbers are stored as plaintext.
# ⚠️  Losing this key makes existing encrypted ID numbers unrecoverable.
FIELD_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Safe to expose — it is constrained by Row Level Security (scripts/029).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_YOUR_ANON_KEY_HERE
# Bypasses RLS entirely. Server-side only — never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ_YOUR_SERVICE_ROLE_KEY_HERE

# ── App ─────────────────────────────────────────────────────────────────────
# Used for Stripe redirects and the URLs encoded into receipt QR codes.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_KEY_HERE

# ── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" switches to api-m.paypal.com; anything else uses sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_RWF_TO_USD_RATE=1450

# ── MTN MoMo (developers.mtn.com / MADAPI) ──────────────────────────────────
MTN_MOMO_BASE_URL=https://api.mtn.com
MTN_MOMO_CONSUMER_KEY=
MTN_MOMO_CONSUMER_SECRET=
# true = simulate the confirmation flow (used while MTN activates the product)
MTN_MOMO_DEMO_MODE=true

# ── Email (nodemailer / Gmail app password) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ── IntouchSMS (Rwanda) ─────────────────────────────────────────────────────
# The ONLY Intouch product this project uses. SMS is sent directly from
# lib/intouch-sms.ts — there is no payment integration and no proxy service.
# Basic auth: username + password. SERVER-ONLY, all four.
INTOUCH_USERNAME=
INTOUCH_PASSWORD=
INTOUCH_SENDER_ID=Movasdom
# Optional — defaults to the correct www URL if unset.
INTOUCH_SMS_API_URL=https://www.intouchsms.co.rw/api/sendsms/.json

# ── Optional local services ─────────────────────────────────────────────────
# Ollama — powers the site chatbot
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# LibreTranslate — powers the language switcher
# Self-host:  docker run -ti -p 5000:5000 libretranslate/libretranslate
LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=   # only if your instance requires one

# Python helper backend (SMS/payment proxy routes)

# OpenAI — optional, only if the OpenAI chat path is used
OPENAI_API_KEY=


# ── Receipts ────────────────────────────────────────────────────────────────
# How long a QR receipt stays verifiable. Long by design: a guest may present a
# receipt months later. /api/verify reveals identity only to signed-in staff, so
# the exposure is small. Accepts any jsonwebtoken duration ("180d", "90d").
# SERVER-ONLY. Optional; defaults to 365d.
RECEIPT_TOKEN_TTL=365d

# ── Trusted origins (CSRF) ──────────────────────────────────────────────────
# proxy.ts rejects state-changing requests whose Origin does not match the host
# the request arrived on. Behind a tunnel or proxy those can differ: ngrok run
# with --host-header=rewrite makes the browser send the tunnel origin while the
# server sees localhost, and the request is refused with 403.
#
# Development allows the mismatch and logs a warning, so phone testing over
# ngrok works out of the box. PRODUCTION BLOCKS IT — list any additional host
# that is legitimate here (comma-separated, scheme optional).
# SERVER-ONLY. Optional.
# TRUSTED_ORIGINS=https://myapp.ngrok-free.dev,https://staging.example.com
