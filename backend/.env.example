# IntouchPay Configuration
INTOUCH_USERNAME=your_username
INTOUCH_ACCOUNT_NO=your_account_number
INTOUCH_PARTNER_PASSWORD=your_partner_password
INTOUCH_ENVIRONMENT=sandbox  # sandbox or production
INTOUCH_PAYMENT_API_URL=https://www.intouchpay.co.rw/api/requestpayment/
INTOUCH_DEPOSIT_API_URL=https://www.intouchpay.co.rw/api/requestdeposit/
INTOUCH_STATUS_API_URL=https://www.intouchpay.co.rw/api/gettransactionstatus/
INTOUCH_BALANCE_API_URL=https://www.intouchpay.co.rw/api/getbalance/

# IntouchSMS Configuration
INTOUCH_SMS_API_KEY=your_sms_api_key
INTOUCH_SMS_API_URL=https://api.intouchsms.co.rw/api/send

# Application Configuration
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CALLBACK_URL=http://localhost:3000/api/intouch/callback

# Database Configuration (optional)
DATABASE_URL=sqlite:///./app.db

# ── Security ────────────────────────────────────────────────────────────────
# Shared secret between the Next.js server and this service. Every endpoint
# that spends money or sends SMS requires it in the X-Internal-Key header.
# MUST be at least 32 characters, and MUST match INTERNAL_API_KEY on the
# Next.js side. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# Set to "production" to disable /docs, drop CORS origins, and make a missing
# INTERNAL_API_KEY a hard startup failure instead of a warning.
APP_ENV=development

# Interface to bind. Defaults to 127.0.0.1 — only change this if something in
# front of the service terminates TLS and authenticates callers.
BIND_HOST=127.0.0.1
PORT=8000
